{
  "name": "@cf-viz/crawler",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js crawler that collects official Cloudflare sources and updates web/public/data (implementation starts in issue #3).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "crawl": "tsx src/main.ts"
  },
  "dependencies": {
    "@cf-viz/catalog": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
