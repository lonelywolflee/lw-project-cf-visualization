{
  "name": "@cf-viz/crawler",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js crawler that collects official Cloudflare sources and updates web/public/data.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "crawl": "tsx src/main.ts",
    "build:curated": "tsx src/build-curated.ts",
    "validate:data": "tsx src/validate-data.ts"
  },
  "dependencies": {
    "@cf-viz/catalog": "workspace:*",
    "cheerio": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
